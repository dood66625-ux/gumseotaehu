	admin off
}

gumseo.kr {
  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Strict-Transport-Security "max-age=86400"
    Cache-Control "no-store"
  }
  # Candidate only: install after the HTTPS runtime and live fulfillment are ready.
  @neverPublic path /.git* /.env* /api/auth/local* /api/local* /api/local-mail/* /api/email-change/local-code /api/test* /api/payments/authenticate
  respond @neverPublic 404
  reverse_proxy 127.0.0.1:3110 {
    header_up X-Gumseo-Client-IP {remote_host}
  }
}

pay.gumseo.kr {
	header {
		-Server
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=86400"
	}
	@reader path /private-reading /private-reading/*
	handle @reader {
		reverse_proxy 127.0.0.1:3450
	}
	handle {
		@private path /admin /login /refund
		respond @private 404
		reverse_proxy 127.0.0.1:3212 {
			header_up Host pay.gumseo.kr
			header_up -Authorization
			header_up -Proxy-Authorization
		}
	}
}
