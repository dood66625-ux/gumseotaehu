# npm run setup generates private local values. Do not use example values as secrets.
APP_MODE=local
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./var/geumseo.sqlite
DATA_KEY=
AUTH_SECRET=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
REPORT_YEAR=2027
# All external effects intentionally disabled. Runtime remains mock-only.
EXTERNAL_EFFECTS=disabled

# Optional test credentials only; never add NEXT_PUBLIC secret variables.
# Adding keys does not enable external requests or real payments.
TOSS_TEST_CLIENT_KEY=
TOSS_TEST_SECRET_KEY=

# Server-only OpenAI key. Do not use NEXT_PUBLIC_; never commit a real key.
# Only the explicit fixed-fixture ai:synthetic command may use it. Customer runtime stays mock.
OPENAI_API_KEY=

# Incoming test webhook only; disabled until a matching test merchant/security key is configured.
# Security key is the provider-issued 64-character hex key, NOT the test_sk_ API key.
TOSS_TEST_WEBHOOK_MODE=disabled
TOSS_TEST_MERCHANT_ID=
TOSS_TEST_WEBHOOK_SECURITY_KEY=
